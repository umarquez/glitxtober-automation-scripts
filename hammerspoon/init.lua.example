-- Example ~/.hammerspoon/init.lua for Glitxtober

GLITX_ROOT =
  os.getenv("HOME") ..
  "/.hammerspoon/glitxtober-automation-scripts"

-- Console output is always enabled.
-- Visual alerts are opt-in and should live on a control display.
GLITX_STATUS_CONFIG = {
  showAlerts = false,
  alertScreen = "secondary",
  recordingAppName = "Sonic Pi",
}

-- Load exactly one episode runner at a time.
GLITX_EPISODE = "01-codigo-sonido"

-- Episode-specific configuration.
-- Uncomment for Episode 03 after checking Sonic Pi > Preferences > IO.
-- GLITX_EP03_CONFIG = {
--   midiPort = "NOMBRE EXACTO DEL PUERTO",
-- }

dofile(GLITX_ROOT .. "/hammerspoon/glitx_status.lua")
dofile(
  GLITX_ROOT ..
  "/hammerspoon/episodes/" ..
  GLITX_EPISODE ..
  "/runner.lua"
)
