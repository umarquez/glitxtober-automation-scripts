-- Example ~/.hammerspoon/init.lua for Glitxtober.
-- Copy/adapt this file; keep only one episode active at a time.

GLITX_ROOT =
  os.getenv("HOME") ..
  "/.hammerspoon/glitxtober-automation-scripts"

-- Console output is always enabled. Visual alerts are opt-in.
GLITX_STATUS_CONFIG = {
  showAlerts = false,
  alertScreen = "secondary",
  recordingAppName = "Sonic Pi",
}

-- Episode directory slug from hammerspoon/episodes/.
GLITX_EPISODE = "01-codigo-sonido"

-- Episode-specific configuration.
-- Uncomment for EP03 after checking Sonic Pi > Preferences > IO.
-- GLITX_EP03_CONFIG = {
--   midiPort = "NOMBRE EXACTO DEL PUERTO",
-- }

dofile(GLITX_ROOT .. "/hammerspoon/glitx_status.lua")
dofile(
  GLITX_ROOT ..
  "/hammerspoon/episodes/" ..
  GLITX_EPISODE ..
  "/runner.lua"
)
